{
  "$meta": {
    "source": "https://www.snellman.fi/",
    "sourceCss": "https://snellman.fi/app/themes/snellmanrecipes/build/app-styles.css?ver=27d3c0241c46fb4f534e",
    "scrapedAt": "2026-05-11",
    "framework": "GDS (Genero Design System) — Snellman recipes theme override",
    "notes": "Token-arvot poimittu CSS:n :root-lohkoista. GDS-perustaso + Snellman brand override (:root #6, 165 tokenia). Brand-override yliajaa perus-GDS:n."
  },

  "color": {
    "base": {
      "white":      { "value": "#ffffff" },
      "black":      { "value": "#333031", "note": "Käytössä ’musta’ on lievästi lämmin antrasiitti, ei puhdas #000" }
    },
    "brand": {
      "green-dark":        { "value": "#00522c", "role": "Brändin pääväri / metsänvihreä. Body-tausta, primary-painike." },
      "green-darkest":     { "value": "#00422c", "role": "ui-01 — pää-tekstin väri, tumma korostus." },
      "green-bright":      { "value": "#005a30", "role": "ui-03 — kirkkaampi vihreä, vaihtoehtoinen aksentti." },
      "green-hover":       { "value": "#7d968a", "role": "Vaalentava hover-tila tummalle vihreälle." },
      "green-button-hover":{ "value": "#1e5f41", "role": "Primary-painikkeen hover-tausta." },
      "green-active":      { "value": "#6cdd66", "role": "Active/highlight, kirkas." },
      "green-transparent": { "value": "#00522c0f", "role": "Hyvin vaalea vihreä taustasävytys." },
      "cream":             { "value": "#f3f2eb", "role": "Pellava/cream — toissijainen tausta (ui-background-02 / ui-02)." },
      "off-white":         { "value": "#faf9f5", "role": "ui-04 — vielä vaaleampi off-white." },
      "yellow":            { "value": "#f2cd5b", "role": "Auringonkukan keltainen aksentti." }
    },
    "semantic": {
      "background":          { "value": "#00522c", "ref": "brand.green-dark", "note": "GDS-token: --gds-body-background-color" },
      "text":                { "value": "#00422c", "ref": "brand.green-darkest", "note": "--gds-body-text-color" },
      "text-on-dark":        { "value": "#ffffff", "ref": "base.white" },
      "surface-card":        { "value": "#ffffff", "ref": "base.white" },
      "surface-muted":       { "value": "#f3f2eb", "ref": "brand.cream" },
      "border-muted":        { "value": "#dddddd", "note": "logo-grid border" },
      "success":             { "value": "#0d9600", "note": "--gds-color-notice" },
      "error":               { "value": "#cc3721", "note": "--gds-color-error" },
      "active":              { "value": "#6cdd66", "note": "--gds-color-active" },
      "focus-outline":       { "value": "var(--gds-color-ui-04)", "resolved": "#faf9f5", "note": "auto-outline focus-renkaalle" }
    },
    "gradient": {
      "stripe-01":              "repeating-linear-gradient(90deg, #00522c, #00522c 15px, #005a30 15px, #005a30 30px)",
      "fade-to-transparent-top": "linear-gradient(180deg, rgba(0,0,0,.56) 0%, rgba(0,0,0,0) 100%)",
      "fade-to-transparent-bot": "linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.56) 100%)"
    }
  },

  "typography": {
    "fontFamily": {
      "display": {
        "value": "tabernaserif, serif",
        "fontFace": "Taberna Serif Regular (OTF), font-display: swap",
        "use": "Otsikot M–2XL (h1–h3 -tyyliset). Litterä lower-case + 0.05em letter-spacing antaa lehtimäisen ilmeen."
      },
      "sans": {
        "value": "thesansb, Arial, Helvetica, sans-serif",
        "fontFace": "TheSansB W5 Plain (400) + W7 Bold (700), OTF, font-display: swap",
        "use": "Body, painikkeet, navigaatio, pienemmät otsikot (XS, S), label."
      }
    },
    "body": {
      "fontFamily":  "sans",
      "fontSize":    "17px",
      "lineHeight":  "27px",
      "fontWeight":  400,
      "color":       "brand.green-darkest"
    },
    "headings": {
      "_naming":  "GDS skaala: xs → 2xl. Snellman korvaa GDS:n perus-arvot omillaan.",
      "_mobileVsDesktop": "Mobile-arvot annettu :root #6:ssa, desktop-arvot media-query-lohkoissa (:root #9 ja #10). Alla mobile / desktop.",
      "xs": {
        "fontFamily":     "sans",
        "fontSize":       { "mobile": "16px", "desktop": "18px" },
        "lineHeight":     "1.5",
        "fontWeight":     "bold (700)",
        "textTransform":  "none",
        "letterSpacing":  "0"
      },
      "s": {
        "fontFamily":     "sans",
        "fontSize":       { "mobile": "20px", "desktop": "24px" },
        "lineHeight":     "1.25",
        "fontWeight":     "bold (700)",
        "textTransform":  "none",
        "letterSpacing":  "0"
      },
      "m": {
        "fontFamily":     "display",
        "fontSize":       { "mobile": "24px", "desktop": "32px" },
        "lineHeight":     "1.125",
        "fontWeight":     "normal (400)",
        "textTransform":  "lowercase",
        "letterSpacing":  "0.05em"
      },
      "l": {
        "fontFamily":     "display",
        "fontSize":       { "mobile": "29px", "desktop": "42px" },
        "lineHeight":     "1.12",
        "fontWeight":     "normal (400)",
        "textTransform":  "lowercase",
        "letterSpacing":  "0.05em"
      },
      "xl": {
        "fontFamily":     "display",
        "fontSize":       { "mobile": "36px", "desktop": "56px" },
        "lineHeight":     "1.125",
        "fontWeight":     "normal (400)",
        "textTransform":  "lowercase",
        "letterSpacing":  "0.05em"
      },
      "2xl": {
        "fontFamily":     "display",
        "fontSize":       { "mobile": "36px", "desktop": "75px" },
        "lineHeight":     "1.12",
        "fontWeight":     "normal (400)",
        "textTransform":  "lowercase",
        "letterSpacing":  "0.05em"
      }
    },
    "paragraph": {
      "xs": { "fontSize": "13px", "lineHeight": "17px", "note": "GDS-perustaso, ei brand-override" },
      "s":  { "fontSize": "14px", "lineHeight": "21px" },
      "m":  { "fontSize": "17px", "lineHeight": "27px" },
      "l":  { "fontSize": "19px", "lineHeight": "29px" },
      "gutter": "32px (var(--gds-spacing-l)) kappaleiden välissä"
    },
    "label": {
      "fontFamily":    "sans",
      "textTransform": "none",
      "s":  { "fontSize": "14px", "fontWeight": 400, "lineHeight": "14px", "letterSpacing": "0.5px" },
      "m":  { "fontSize": "12px", "fontWeight": 500, "lineHeight": "16px", "letterSpacing": "1px" },
      "l":  { "fontSize": "16px", "fontWeight": 400, "lineHeight": "19px", "letterSpacing": "1.28px" },
      "xl": { "fontSize": "16px", "fontWeight": 600, "lineHeight": "19px", "letterSpacing": "1.28px" }
    },
    "blockquote": {
      "fontSize":   { "mobile": "28px", "desktop": "32px" },
      "lineHeight": { "mobile": "1.38", "desktop": "1.44" },
      "citeFontSize": "19px (paragraph-l)"
    }
  },

  "spacing": {
    "_scale": "Pohjautuu 4-asteikkoon, mutta hyppää L:n jälkeen 8 ja 16 askelin (xl=40, 2xl=48, 3xl=80).",
    "3xs": "4px",
    "2xs": "8px",
    "xs":  "12px",
    "s":   "16px",
    "m":   "24px",
    "l":   "32px",
    "xl":  "40px",
    "2xl": "48px",
    "3xl": "80px"
  },

  "layout": {
    "grid": {
      "columns": 12,
      "columnWidth": "78px",
      "gutter":      { "mobile": "12px", "desktop": "24px" },
      "viewportGutter": "24px"
    },
    "blockGutter": {
      "s":   "24px",
      "base":"40px",
      "l":   { "mobile": "40px", "desktop": "80px" }
    },
    "footerGutter": "95px",
    "content": {
      "width":      "calc(8 * 78px + 7 * gutter)",
      "wideWidth":  "calc(12 * 78px + 11 * gutter)",
      "fullWidth":  "unset"
    },
    "navigation": {
      "desktopHeight": "100px",
      "mobileHeight":  "70px",
      "navHeightToken": "80px (sticky), 128px (desktop varjopaikka)",
      "searchFieldHeight": "70px",
      "topAlertHeight": "37px",
      "topMenuHeight": "40px"
    }
  },

  "radius": {
    "_naming": "Snellman-brand suosii TERÄVÄKULMAISIA muotoja — painikkeet ja kortit ovat usein border-radius: 0.",
    "none":   "0",
    "tag":    "5px",
    "input":  "0 (sharp, terävä)",
    "card":   "0 (brand-override; GDS-perustaso oli 40px)",
    "button": "0 (brand-override; GDS-perustaso oli 8px)",
    "accordion": "8px",
    "hint":   "4px 4px 4px 0",
    "consent":"20px"
  },

  "shadow": {
    "_naming": "Snellman korttiTyyli on brand-overridena `box-shadow: none` — käytetään litteää designia.",
    "card-default-gds": "5px 5px 15px #64646426, -5px -5px 15px #fffc",
    "card-snellman":    "none",
    "accordion":        "0 0 8px rgba(0,0,0,0.12)"
  },

  "components": {
    "button": {
      "fontFamily":     "sans (thesansb, bold)",
      "fontWeight":     "bold (700)",
      "textTransform":  "uppercase",
      "borderRadius":   "0",
      "border":         "none",
      "boxShadow":      "none",
      "transition":     "background-color 0.1s ease-out",
      "sizes": {
        "s": { "fontSize": "16px", "padding": "12px 24px", "letterSpacing": "1.6px" },
        "m": { "fontSize": "16px", "padding": "18px 32px 14px 32px", "letterSpacing": "0" },
        "l": { "fontSize": "18px", "padding": "18px 32px 14px 32px", "letterSpacing": "1.28px" }
      },
      "primary": {
        "background":       "#00522c (brand.green-dark)",
        "backgroundHover":  "#1e5f41",
        "backgroundActive": "#1e5f41",
        "color":            "#ffffff",
        "colorHover":       "#ffffff"
      },
      "iconGutter": "16px"
    },
    "tag": {
      "padding":      "8px",
      "background":   "#ffffff",
      "color":        "#00422c (brand.green-darkest)",
      "borderRadius": "5px",
      "lineHeight":   "1em",
      "groupGutter":  { "x": "8px", "y": "8px" }
    },
    "card": {
      "background":    "#ffffff",
      "border":        "none",
      "borderRadius":  "0",
      "boxShadow":     "none",
      "maxWidth":      "100%",
      "textAlign":     "center",
      "height":        "100%"
    },
    "mediaCard": {
      "mediaHeight":     "70.92% aspect-ratio (cover)",
      "objectFit":       "cover",
      "blurRadius":      "10px",
      "blurOpacity":     "0.5",
      "overlayColor":    "#ffffff",
      "overlayOpacity":  "0.75",
      "contentPadding":  { "mobile": "24px", "desktop": "32px" }
    },
    "navigation": {
      "color":          "#ffffff (brand-override)",
      "background":     "#ffffff (GDS-perustaso — Snellman-headerin tausta on todennäköisesti läpinäkyvä tai vihreä)",
      "menuItem": {
        "fontFamily":    "sans bold",
        "fontSize":      "18px",
        "fontWeight":    "bold (700)",
        "textTransform": "uppercase",
        "letterSpacing": "0",
        "underlineOffset": "8px (active)"
      },
      "hamburger": {
        "width":        "25px",
        "thickness":    "3px",
        "lineGap":      "5px",
        "color":        "currentColor"
      }
    },
    "input": {
      "background":     "#ffffff (override) / #eeeeee (GDS)",
      "color":          "#333031 (black)",
      "border":         "1px solid (background-väri)",
      "borderFocus":    "1px solid #4573ae",
      "borderRadius":   "0",
      "padding":        "12px 16px",
      "minHeight":      "36px",
      "placeholderColor": "#a9a9a9",
      "fontFamily":     "sans"
    },
    "accordion": {
      "background":          "#ffffff",
      "expandedHeaderBg":    "#00522c (brand.green-dark)",
      "border":              "none",
      "borderRadius":        "8px",
      "boxShadow":           "0 0 8px rgba(0,0,0,0.12)",
      "padding":             "16px"
    },
    "consentManager": {
      "background":     "#ffffff",
      "overlay":        "rgba(0,0,0,0.3)",
      "maxWidth":       "min(600px, calc(100vw - 8px))",
      "borderRadius":   "20px",
      "padding":        "4rem"
    },
    "searchForm": {
      "color":          "#ffffff",
      "background":     "transparent",
      "border":         "0",
      "borderRadius":   "0",
      "inputWidth":     "calc(7ch + button-width)",
      "inputWidthFocus":"calc(15ch + button-width)"
    },
    "icon": {
      "color":      "#333031",
      "hoverColor": "#acacac",
      "fontSize":   "17px (paragraph-m)"
    }
  },

  "effects": {
    "focus": {
      "outline": "auto var(--gds-color-ui-04)",
      "note":    "GDS käyttää browserin auto-outline-tyyliä Snellmanin vaalean off-whiten värisenä."
    },
    "transitions": {
      "button":       "background-color 0.1s ease-out",
      "textButton":   "transform 0.1s ease-out"
    }
  }
}
